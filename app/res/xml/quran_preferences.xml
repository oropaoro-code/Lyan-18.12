<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/menu_settings" android:key="@string/prefs_path"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/prefs_category_display_settings" android:key="@string/prefs_display_category_key" app:iconSpaceReserved="false">
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_use_arabic_title" android:key="@string/prefs_use_arabic_names" android:summary="@string/prefs_use_arabic_summary_on" android:defaultValue="false" android:disableDependentsState="false" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_lock_orientation_title" android:key="@string/prefs_lock_orientation" android:defaultValue="false" android:summaryOn="@string/prefs_lock_orientation_summary_on" android:summaryOff="@string/prefs_lock_orientation_summary_off" android:disableDependentsState="false" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_landscape_orientation_title" android:key="@string/prefs_landscape_orientation" android:dependency="@string/prefs_lock_orientation" android:summaryOn="@string/prefs_landscape_orientation_summary_on" android:summaryOff="@string/prefs_landscape_orientation_summary_off" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_night_mode_title" android:key="@string/prefs_night_mode" android:summary="@string/prefs_night_mode_summary" app:iconSpaceReserved="false" />
        <app.layan.quran.ui.preference.SeekBarTextBrightnessPreference android:persistent="true" android:max="255" android:title="@string/prefs_night_mode_text_brightness_title" android:key="@string/prefs_night_mode_text_brightness" android:summary="@string/prefs_night_mode_text_brightness_summary" android:dependency="@string/prefs_night_mode" android:defaultValue="255" />
        <app.layan.quran.ui.preference.SeekBarBackgroundBrightnessPreference android:persistent="true" android:max="64" android:title="@string/prefs_night_mode_background_brightness_title" android:key="@string/prefs_night_mode_background_brightness" android:summary="@string/prefs_night_mode_background_brightness_summary" android:dependency="@string/prefs_night_mode" android:defaultValue="0" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/prefs_category_reading" android:key="@string/prefs_reading_category_key" app:iconSpaceReserved="false">
        <Preference android:title="@string/prefs_page_type_title" android:key="@string/prefs_page_type" android:summary="@string/prefs_page_type_summary" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_overlay_page_info_title" android:key="@string/prefs_overlay_page_info" android:summary="@string/prefs_overlay_page_info_summary" android:defaultValue="true" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_display_marker_title" android:key="@string/prefs_display_marker_popup" android:summary="@string/prefs_display_marker_summary" android:defaultValue="true" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_highlight_bookmarks_title" android:key="@string/prefs_highlight_bookmarks" android:summary="@string/prefs_highlight_bookmarks_summary" android:defaultValue="true" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_volume_key_navigation_title" android:key="@string/prefs_volume_key_navigation" android:summary="@string/prefs_volume_key_navigation_summary" android:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/prefs_category_dual_screen" android:key="@string/prefs_category_dual_screen_key" app:iconSpaceReserved="false">
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_dual_page_mode_title" android:key="@string/prefs_dual_page_enabled" android:defaultValue="@bool/use_tablet_interface_by_default" android:summaryOn="@string/prefs_dual_page_mode_enabled" android:summaryOff="@string/prefs_dual_page_mode_disabled" android:disableDependentsState="false" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_split_page_and_translation_title" android:key="@string/prefs_split_page_and_translation" android:summary="@string/prefs_split_page_and_translation_summary" android:dependency="@string/prefs_dual_page_enabled" android:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/prefs_category_translation" app:iconSpaceReserved="false">
        <Preference android:title="@string/prefs_translations" android:key="@string/prefs_translation_manager_key" android:summary="@string/prefs_translations_summary" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_ayah_before_translation_title" android:key="@string/prefs_ayah_before_translation" android:summary="@string/prefs_ayah_before_translation_summary" android:defaultValue="true" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_use_dyslexic_font_title" android:key="@string/prefs_use_dyslexic_font" android:summary="@string/prefs_use_dyslexic_font_summary" android:defaultValue="false" app:iconSpaceReserved="false" />
        <app.layan.quran.ui.preference.SeekBarTextSizePreference android:persistent="true" android:max="40" android:title="@string/prefs_translation_text_title" android:key="@string/prefs_translation_text_size" android:defaultValue="15" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/prefs_category_download" android:key="@string/prefs_download_category_key" app:iconSpaceReserved="false">
        <CheckBoxPreference android:persistent="true" android:title="@string/prefs_streaming_title" android:key="@string/prefs_prefer_streaming" android:summary="@string/prefs_streaming_summary" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:entries="@array/download_amount_preference" android:title="@string/prefs_download_amount_title" android:key="@string/prefs_download_amount" android:summary="@string/prefs_download_amount_summary" android:defaultValue="1" android:dialogTitle="@string/prefs_download_amount_title" android:entryValues="@array/download_amount_preference_values" app:iconSpaceReserved="false" />
        <Preference android:title="@string/prefs_audio_manager" android:key="@string/prefs_audio_manager_key" android:summary="@string/prefs_audio_manager_summary" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/layan_dhikr_title" android:key="layan_dhikr_settings" app:iconSpaceReserved="false">
        <CheckBoxPreference android:title="@string/layan_dhikr_enable" android:key="layan_dhikr_enabled" android:summary="@string/layan_dhikr_summary" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:entries="@array/layan_dhikr_intervals" android:title="@string/layan_dhikr_interval_title" android:key="layan_dhikr_interval" android:summary="%s" android:defaultValue="5" android:dialogTitle="@string/layan_dhikr_interval_title" android:entryValues="@array/layan_dhikr_values" app:iconSpaceReserved="false" />
        <CheckBoxPreference android:title="@string/layan_dhikr_silent_title" android:key="layan_dhikr_silent" android:defaultValue="false" app:iconSpaceReserved="false" />
    <Preference android:key="layan_dhikr_background" android:title="@string/layan_dhikr_background_title" android:summary="@string/layan_dhikr_background_summary" app:iconSpaceReserved="false"><intent android:targetPackage="app.layan.quran" android:targetClass="app.layan.quran.DhikrBackgroundSettingsActivity" /></Preference>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/prefs_category_advanced" android:key="@string/prefs_advanced_path" app:iconSpaceReserved="false">
        <Preference android:title="@string/prefs_category_advanced" android:key="key_prefs_advanced" android:summary="@string/prefs_category_advanced_summary" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
