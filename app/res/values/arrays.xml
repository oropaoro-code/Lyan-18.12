        <item>فَنَبَذْنَاهُ بِالْعَرَاءِ وَهُوَ</item>
        <item>وَهَلْ أَتَاكَ نَبَأُ الْخَصْمِ إِذْ</item>
        <item>وَعِندَهُمْ قَاصِرَاتُ الطَّرْفِ</item>
        <item>وَإِذَا مَسَّ الْإِنسَانَ ضُرٌّ دَعَا</item>
        <item>فَمَنْ أَظْلَمُ مِمَّن كَذَبَ عَلَى</item>
        <item>قُلْ يَا عِبَادِيَ الَّذِينَ</item>
        <item>حم</item>
        <item>أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ</item>
        <item>وَيَا قَوْمِ مَا لِي أَدْعُوكُمْ إِلَى</item>
        <item>قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ</item>
        <item>قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ</item>
        <item>وَقَيَّضْنَا لَهُمْ قُرَنَاءَ</item>
        <item>إِلَيْهِ يُرَدُّ عِلْمُ السَّاعَةِ ۚ</item>
        <item>شَرَعَ لَكُم مِّنَ الدِّينِ مَا</item>
        <item>وَلَوْ بَسَطَ اللَّهُ الرِّزْقَ</item>
        <item>وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ</item>
        <item>قَالَ أَوَلَوْ جِئْتُكُم بِأَهْدَىٰ</item>
        <item>وَلَمَّا ضُرِبَ ابْنُ مَرْيَمَ مَثَلًا</item>
        <item>وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ</item>
        <item>اللَّهُ الَّذِي سَخَّرَ لَكُمُ</item>
        <item>حم</item>
        <item>وَاذْكُرْ أَخَا عَادٍ إِذْ أَنذَرَ</item>
        <item>أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ</item>
        <item>يَا أَيُّهَا الَّذِينَ آمَنُوا</item>
        <item>لَّقَدْ رَضِيَ اللَّهُ عَنِ</item>
        <item>يَا أَيُّهَا الَّذِينَ آمَنُوا لَا</item>
        <item>قَالَتِ الْأَعْرَابُ آمَنَّا ۖ قُل</item>
        <item>قَالَ قَرِينُهُ رَبَّنَا مَا</item>
        <item>قَالَ فَمَا خَطْبُكُمْ أَيُّهَا</item>
        <item>وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ</item>
        <item>وَكَم مِّن مَّلَكٍ فِي السَّمَاوَاتِ</item>
        <item>كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ</item>
        <item>الرَّحْمَٰنُ</item>
        <item>إِذَا وَقَعَتِ الْوَاقِعَةُ</item>
        <item>فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ</item>
        <item>أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَن</item>
        <item>قَدْ سَمِعَ اللَّهُ قَوْلَ الَّتِي</item>
        <item>أَلَمْ تَرَ إِلَى الَّذِينَ تَوَلَّوْا</item>
        <item>أَلَمْ تَرَ إِلَى الَّذِينَ نَافَقُوا</item>
        <item>عَسَى اللَّهُ أَن يَجْعَلَ بَيْنَكُمْ</item>
        <item>يُسَبِّحُ لِلَّهِ مَا فِي</item>
        <item>وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ</item>
        <item>يَا أَيُّهَا النَّبِيُّ إِذَا</item>
        <item>يَا أَيُّهَا النَّبِيُّ لِمَ</item>
        <item>تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ</item>
        <item>ن ۚ وَالْقَلَمِ وَمَا يَسْطُرُونَ</item>
        <item>الْحَاقَّةُ</item>
        <item>إِنَّ الْإِنسَانَ خُلِقَ هَلُوعًا</item>
        <item>قُلْ أُوحِيَ إِلَيَّ أَنَّهُ</item>
        <item>إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ</item>
        <item>لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ</item>
        <item>وَيَطُوفُ عَلَيْهِمْ وِلْدَانٌ</item>
        <item>عَمَّ يَتَسَاءَلُونَ</item>
        <item>عَبَسَ وَتَوَلَّىٰ</item>
        <item>إِذَا السَّمَاءُ انفَطَرَتْ</item>
        <item>إِذَا السَّمَاءُ انشَقَّتْ</item>
        <item>سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى</item>
        <item>لَا أُقْسِمُ بِهَٰذَا الْبَلَدِ</item>
        <item>أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</item>
        <item>أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا</item>
    </string-array>
