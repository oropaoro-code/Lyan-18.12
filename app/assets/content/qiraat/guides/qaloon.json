  "nameArabic": "قَالُون عَن نَافِع",
  "stopSigns": [
    {
      "symbol": "م",
      "title": "الوقف اللازم",
      "meaning": "علامة الوقف اللازم في اصطلاح الضبط: قف هنا دفعًا لإيهام معنى غير مراد عند الوصل، ثم ابتدئ ابتداءً صحيحًا. وصف الوقف باللازم اصطلاح أداء، ولا يعني أن كل وصل عند العلامة محرم شرعًا."
    },
    {
      "symbol": "لا",
      "title": "علامة «لا»",
      "meaning": "راعِ اصطلاح الطبعة والسياق: توضع «لا» للوقف الممنوع في بعض المصاحف، وللوقف الحسن مع عدم صلاحية الابتداء بما بعده في اصطلاح آخر. إذا وقفت لحاجة فأعد من موضع يصح به المعنى والابتداء؛ لا تفصل ما بعد العلامة عما يتعلق به."
    },
    {
      "symbol": "ج",
      "title": "الوقف الجائز",
      "meaning": "يجوز الوقف والوصل، مع مراعاة المعنى وحسن الابتداء."
    },
    {
      "symbol": "صلى",
      "title": "الوصل أولى",
      "meaning": "الوقف جائز، والوصل أولى في هذا الموضع."
    },
    {
      "symbol": "قلى",
      "title": "الوقف أولى",
      "meaning": "الوصل جائز، والوقف أولى في هذا الموضع."
    },
    {
      "symbol": "∴ ∴",
      "title": "تعانق الوقف",
      "meaning": "إذا وقفت على أحد الموضعين المتعانقين فلا تقف على الآخر في السياق نفسه؛ ويجوز وصلهما."
    },
    {
      "symbol": "س",
      "title": "السكت",
      "meaning": "قطع لطيف للصوت بلا نفس في الموضع المنقول في الرواية؛ لا تستبدله بوقف مع تنفس."
    }
  ],
  "guideIntroduction": "دليل علامات قَالُون عَن نَافِع. افتح الشرح من عنوان الدليل أو اضغط على أي علامة. يشرح كل لون ورسم وطريقة الأداء في هذه النسخة، ثم يبين علامات الضبط والوقف. الأوجه المنقولة تؤخذ مع الالتزام بطريق القراءة.",
  "readingNotes": [
    "قالون: في «هار» من سورة التوبة الإمالة. وله في ميم الجمع أوجه الإسكان والصلة بحسب الطريق؛ النسخة تعرض الضبط المرسوم، ولا يجعل غياب لون الصلة نفيًا لوجه آخر منقول.",
    "في لفظ «التوراة» لقالون الفتح والتقليل بحسب الوجه المأخوذ به. التقليل بين الفتح والإمالة الكبرى؛ لا يُحوَّل كل اختلاف ملون عن حفص إلى إمالة."
