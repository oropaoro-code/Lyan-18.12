    },
    {
      "title": "الكسرة",
      "symbol": "ِ",
      "short": "حرف مكسور",
      "meaning": "حركة قصيرة تحت الحرف، تدل على نطقه مكسورًا. الكسرة وحدها ليست ياء مد.",
      "verified": true
    },
    {
      "title": "السكون",
      "symbol": "ْ",
      "short": "حرف بلا حركة",
